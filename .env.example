# Sealed cookie session secret for nuxt-auth-utils (32+ characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
NUXT_SESSION_PASSWORD=replace-with-a-random-32-character-string

# First admin, created by the `db:seed` Nitro task (skipped if any admin exists)
NUXT_ADMIN_EMAIL=admin@example.com
NUXT_ADMIN_PASSWORD=change-me-now
NUXT_ADMIN_NAME=Administrator

# Timezone used for all period / archive date math
NUXT_PUBLIC_APP_TIMEZONE=UTC
